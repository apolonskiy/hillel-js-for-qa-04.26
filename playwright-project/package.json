{
  "name": "playwright-project",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "lint": "eslint . --ext .js,.mjs",
    "lint:fix": "npm run lint -- --fix",
    "playwright:test": "playwright test",
    "playwright:test:headed": "playwright test --headed",
    "playwright:test:headed:chrome": "playwright test --headed --project='Google Chrome'",
    "playwright:test:headed:chrome:qa1-export-example": "export $(cat .env) &&  playwright test --headed --project='Google Chrome'",
    "playwright:test:headed:chrome:qa1": "cross-env TEST_ENV=qauto1 playwright test --headed --project='Google Chrome'",
    "playwright:test:headless:chrome:qa1": "cross-env TEST_ENV=qauto1 playwright test --project='Google Chrome'",
    "playwright:test:headed:chrome:qa2": "cross-env TEST_ENV=qauto2 playwright test --headed --project='Google Chrome'",
    "playwright:test:headless:chrome:qa2": "cross-env TEST_ENV=qauto2 playwright test --project='Google Chrome'",
    "playwright:test:headed:chrome:qa1:chromeSetup": "cross-env TEST_ENV=qauto1 playwright test --headed --project=singleLoginChrome"

  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testomatio/reporter": "^2.9.3",
    "@types/node": "^26.0.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.4"
  }
}
